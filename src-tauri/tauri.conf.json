{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PokeBonk Rust",
  "version": "0.1.3",
  "identifier": "local.pokebonk.rust",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "capabilities": ["game-window"], "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app"],
    "category": "Game",
    "shortDescription": "PokéBonk 的独立 Rust 桌面客户端",
    "icon": ["icons/icon.icns", "icons/128x128.png"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGN0QxQjZCM0E3NDIxMEIKUldRTElYUTZheHQ5ci80NThWTDJQYWFzeER3UEFIR2NDeEsxVXFId1RLaXJsR0dKY3dsUitNSVoK",
      "endpoints": [
        "https://github.com/AdonisSheldon/pokebonk-rust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
