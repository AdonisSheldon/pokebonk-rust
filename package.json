{
  "name": "pokebonk-rust-macos",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --bundles app",
    "build:apple": "tauri build --bundles app --target aarch64-apple-darwin",
    "build:intel": "tauri build --bundles app --target x86_64-apple-darwin",
    "build:windows": "tauri build --bundles nsis --target x86_64-pc-windows-msvc",
    "test:bridge": "node --test tests/bridge.test.cjs tests/pointer-lock.test.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
